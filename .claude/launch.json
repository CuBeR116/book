{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "game-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "Игра"
      ],
      "port": 8777,
      "url": "http://127.0.0.1:8777"
    },
    {
      "name": "game-lan",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "Игра/node_modules/vite/bin/vite.js",
        "Игра",
        "--host",
        "0.0.0.0",
        "--port",
        "8779",
        "--strictPort"
      ],
      "port": 8779,
      "url": "http://127.0.0.1:8779"
    },
    {
      "name": "game-script",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "Игра/node_modules/vite/bin/vite.js",
        "Игра",
        "--host",
        "127.0.0.1",
        "--port",
        "8783",
        "--strictPort"
      ],
      "port": 8783,
      "url": "http://127.0.0.1:8783"
    },
    {
      "name": "game-dist",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8790",
        "--bind",
        "127.0.0.1",
        "--directory",
        "Игра/dist"
      ],
      "port": 8790,
      "url": "http://127.0.0.1:8790"
    },
    {
      "name": "roblox-rojo",
      "runtimeExecutable": "Roblox/tools/bin/rojo.exe",
      "runtimeArgs": [
        "serve",
        "Roblox/default.project.json",
        "--port",
        "34872"
      ],
      "port": 34872,
      "url": "http://localhost:34872"
    },
    {
      "name": "covers",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8791",
        "--bind",
        "127.0.0.1",
        "--directory",
        "Арты/Эмерин/Обложка — черновик"
      ],
      "port": 8791,
      "url": "http://127.0.0.1:8791"
    }
  ]
}
